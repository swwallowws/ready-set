{
  "name": "tabridge-extension",
  "type": "module",
  "main": "dist/extension.js",
  "scripts": {
    "build": "tsc --noEmit && tsx build.ts",
    "build:prod": "tsc --noEmit && tsx build.ts --production",
    "wasm": "cd .. && wasm-pack build --target nodejs --out-dir extension/pkg --out-name tabridge",
    "start": "tsx build.ts && extensions-cli run",
    "test": "node test/local-sources.test.ts",
    "package": "tsc --noEmit && tsx build.ts --production && extensions-cli package"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:./vendor/ableton-extensions-sdk-1.0.0-beta.0.tgz"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:./vendor/ableton-extensions-cli-1.0.0-beta.0.tgz",
    "@types/node": "^22.10.0",
    "esbuild": "0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
